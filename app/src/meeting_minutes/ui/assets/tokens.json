  "breakpoint": {
    "note": "Measured on the window's client width in logical px. 1366x768@100% = 1366; @125% = 1093; @150% = 911; @200% = 683. 1920x1080@150% = 1280; @200% = 960.",
    "wide": 1280,
    "medium": 960,
    "narrow": 760
  },
  "elevation": {
    "flyout": {"blur": 16, "y": 4, "alpha": 0.14},
    "dialog": {"blur": 32, "y": 8, "alpha": 0.22},
    "note": "Qt: QGraphicsDropShadowEffect only on dialogs/popovers; never on list rows (performance)."
  },
  "motion": {
    "fast": 120,
    "base": 180,
    "note": "Only opacity/colour fades and the live 'recording' dot. Respect Windows 'Animation effects' off (QStyleHints / SPI_GETCLIENTAREAANIMATION) by disabling all."
  }
