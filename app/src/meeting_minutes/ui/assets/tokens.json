    "titleBar.height": 32,
    "sidePanel.width": 320,
    "sidePanel.minWidth": 280,
    "content.maxWidth": 1120,
    "form.maxWidth": 720,
    "transcript.timeColumn": 64,
    "transcript.sourceColumn": 84,
