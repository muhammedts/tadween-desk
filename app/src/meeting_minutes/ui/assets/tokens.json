  "font": {
    "family.ui": ["Segoe UI Variable Text", "Segoe UI", "Tahoma", "sans-serif"],
    "family.display": ["Segoe UI Variable Display", "Segoe UI", "sans-serif"],
    "family.transcript": ["Segoe UI Variable Text", "Segoe UI", "Tahoma", "sans-serif"],
    "family.transcriptArabicFallback": ["Segoe UI", "Tahoma", "Arial"],
    "family.mono": ["Cascadia Mono", "Consolas", "monospace"],
    "note": "All families ship with Windows 11. Segoe UI contains Arabic glyphs and shaping; Qt falls back per glyph. No fonts are bundled."
  },
  "type": {
    "display": {"size": 24, "lineHeight": 32, "weight": 600, "family": "display"},
    "title":   {"size": 20, "lineHeight": 28, "weight": 600, "family": "display"},
    "subtitle":{"size": 16, "lineHeight": 22, "weight": 600, "family": "ui"},
    "body":    {"size": 14, "lineHeight": 20, "weight": 400, "family": "ui"},
    "bodyStrong": {"size": 14, "lineHeight": 20, "weight": 600, "family": "ui"},
    "caption": {"size": 12, "lineHeight": 16, "weight": 400, "family": "ui"},
    "captionStrong": {"size": 12, "lineHeight": 16, "weight": 600, "family": "ui"},
    "transcript": {"size": 15, "lineHeight": 24, "weight": 400, "family": "transcript"},
    "transcriptArabic": {"size": 16, "lineHeight": 28, "weight": 400, "family": "transcript", "note": "Arabic paragraphs render one step larger for legibility of diacritics and joined forms."},
    "timestamp": {"size": 12, "lineHeight": 16, "weight": 400, "family": "mono", "features": "tabular numbers"},
    "button":  {"size": 14, "lineHeight": 20, "weight": 600, "family": "ui"},
    "pt_note": "Qt QFont.setPixelSize is NOT used; convert with pt = px * 0.75 so Windows scaling applies. 14 px = 10.5 pt, 15 px = 11.25 pt."
  },
  "space": {"0": 0, "1": 2, "2": 4, "3": 8, "4": 12, "5": 16, "6": 20, "7": 24, "8": 32, "9": 40, "10": 48},
